@@ -0,0 +1,8 @@
+# D2 spacing tune (PO 2026-11-03) — match-setup vertical gaps
+Base: cloud/d2-final-design 13c2e773705b5253668b4506172f724ffe78688a (main 387d232 unchanged). Branch cloud/d2-spacing-tune. Local only; not pushed. No build numbering / Archive / ASC.
+Change (match-setup-ux-v1.css only, 4 lines in the D2 block):
+- heading -> cards: clamp(18px,10vh,96px) -> clamp(24px,6vh,60px)  (390pt: 85 -> 52pt)
+- cards -> shot clock: clamp(16px,9vh,88px) -> clamp(20px,5.3vh,56px)  (390pt: 76 -> 45pt)
+- top spacer cap: clamp(0px,10vh,96px) -> clamp(0px,16vh,150px); bottom spacer weight 1.2 -> 1 (top : bottom = 1 : 1) so the tightened space is shared above and below instead of piling up under the shot clock.
+Unchanged: avatar 68px, selected name 23px, guidance 18px, Race to 17px, in-card (i), dashed unselected card, no blue-grey note, visually folded footer reason (VoiceOver text kept), shot clock, start-button gap (24pt at 390), Score 1/2 registration, Player IDs, start condition.
+Tests: d-plan-initial-players.test.mjs pin updated (clamp(24px,6vh,60px)); browser d2-final.mjs now asserts the new gap formulas, the 390pt targets (45-55 / 40-50pt) and a top:bottom blank ratio <= 1.5; d-plan-setup.mjs heading-gap floor C+30 -> C+20 (320pt = +24). Change map: tests/fixtures/p2/version-d2-spacing-test-change-map.json.
diff --git a/match-setup-ux-v1.css b/match-setup-ux-v1.css
index 0a7cc73..f8c20c7 100644
--- a/match-setup-ux-v1.css
+++ b/match-setup-ux-v1.css
@@ -99,8 +99,9 @@ body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 #cueSetupFooterV1{p
    - the footer reason keeps its text / aria-label / aria-description (VoiceOver) but is folded away visually (it duplicated the card guidance);
    - calmer shot-clock card (same controls, same 44px targets);
    - spare height is spread over the top, heading->cards, cards->shot clock and footer gaps (vh based) instead of piling up in one place. */
-body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-new-match-integrated-v2::before{max-height:clamp(0px,10vh,96px)}
-body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-new-match-summary-v2{margin:0 0 clamp(18px,10vh,96px)!important}
+body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-new-match-integrated-v2::after{flex:1 1 0}
+body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-new-match-integrated-v2::before{max-height:clamp(0px,16vh,150px)}
+body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-new-match-summary-v2{margin:0 0 clamp(24px,6vh,60px)!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .new-match-player-card-v1{padding:10px 8px 8px!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .new-match-swap-v1{top:34px!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .new-match-player-card-v1.is-empty-v1{border:1.5px dashed #c8c8c4!important;background:#fff!important}
@@ -115,7 +116,7 @@ body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-player-stack-v
 @media(max-width:379px){body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-player-stack-v2 .is-empty-v1 .new-match-player-select-v1 .new-match-player-name-v1{min-height:44px!important}body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-player-stack-v2 .new-match-player-card-v1:not(.is-empty-v1) .new-match-player-select-v1 .new-match-player-name-v1{min-height:44px!important;line-height:44px!important}}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .new-match-race-row-v2 strong{font-size:17px!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .new-match-race-row-v2 .goal-label-v1{font-size:11px!important}
-body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-sc-setup{margin-top:clamp(16px,9vh,88px)!important;padding:3px 12px!important;border-color:#ececea!important}
+body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-sc-setup{margin-top:clamp(20px,5.3vh,56px)!important;padding:3px 12px!important;border-color:#ececea!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-sc-setup-title{font-size:15px!important;line-height:20px!important;font-weight:500!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-sc-setup-sub{font-size:11px!important;line-height:14px!important}
 body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .cue-setup-reason-wrap-v1{min-height:0!important}
