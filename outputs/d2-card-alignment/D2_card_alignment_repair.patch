+/* Card alignment repair (Build 99 STOP): when a guidance label wraps in one card only (the class is set by match-setup-ux-v1.js), both name boxes get the same two-line height so both cards keep the same top / height / Race-to row. */
+body.cue-phase1-normal-mode #cueHomeV1.match-setup-active-v3 .new-match-player-grid-v1.cue-name-wrap-v1 .is-empty-v1 .new-match-player-select-v1 .new-match-player-name-v1{min-height:44px!important}
