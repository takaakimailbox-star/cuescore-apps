{
  "id": "./",
  "name": "CueScore Rotation Scoreboard",
  "short_name": "CueScore",
  "description": "ローテーション競技用スコアボード。試合記録、分析、履歴、統計、クラウド同期に対応します。",
  "lang": "ja",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f3220",
  "theme_color": "#123f28",
